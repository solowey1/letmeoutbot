# ==================================
# Telegram Bot Configuration
# ==================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SUPPORT_BOT_TOKEN=your_support_bot_token_here
ADMIN_IDS=123456789,987654321

# ==================================
# Maintenance mode
# When true, purchases are disabled and users see a maintenance notice.
# ==================================
MAINTENANCE_MODE=false

# ==================================
# X-RAY Configuration
# ==================================
XRAY_SUB_BASE_URL=https://example.com/sub
# Inbound IDs to register each client in (comma-separated).
# The subscription URL will automatically include all protocols from these inbounds.
# Default is 1 (VLESS Reality only). Add Hysteria2 or other inbound IDs as needed.
XRAY_INBOUNDS=1,2
XRAY_PANEL_URL=http://example.com:45147/ABCdefGHIgklmNOPqrs
XRAY_API_TOKEN=your-api-token-here
XRAY_PUBLIC_KEY=your-public-key-here

# ==================================
# MTProto Proxy (Telegram-only proxy, see ops/mtproto/README.md)
# API listens on the node's localhost; reach it via SSH tunnel from the bot
# host (e.g. http://127.0.0.1:8081) or an IP-allowlisted port.
# ==================================
MTPROTO_API_URL=http://127.0.0.1:8081
MTPROTO_API_TOKEN=your-mtproto-api-token-here

# ==================================
# Database Configuration
# ==================================
# Options: 'sqlite', 'postgres', or 'supabase'
DATABASE_TYPE=supabase

# ----------------------------------
# SQLite (if DATABASE_TYPE=sqlite)
# ----------------------------------
DATABASE_PATH=./database.db

# ----------------------------------
# Supabase (if DATABASE_TYPE=supabase) - RECOMMENDED
# ----------------------------------
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_API_KEY=your_supabase_anon_key_here

# ----------------------------------
# PostgreSQL Direct (if DATABASE_TYPE=postgres)
# ----------------------------------
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or use your own PostgreSQL server
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# OR specify PostgreSQL connection parameters separately:
POSTGRES_HOST=aws-0-eu-central-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your_postgres_password

# ==================================
# Application Settings
# ==================================
NODE_ENV=production
LOG_LEVEL=info

# ==================================
# TON / GRAM Payments
# (coin renamed Toncoin → Gram, June 2026; blockchain still TON)
# ==================================

# 24-word BIP39 mnemonic of the bot's hot wallet.
# This wallet must hold GRAM to pay out referral rewards automatically.
# Generate at: https://mnemonic.tonkeeper.com or any TON wallet app.
TON_MNEMONIC=word1 word2 word3 ... word24

# API key for tonapi.io — get a free key at https://tonconsole.com
# Free tier: 1 RPS (enough for a small bot).
TON_API_KEY=your_tonapi_key_here

# Stars → USD conversion rate (Telegram sells 50 Stars for ~$1).
# Adjust only if Telegram changes its pricing.
STARS_USD_RATE=0.02
