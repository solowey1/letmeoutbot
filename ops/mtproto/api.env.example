# openssl rand -hex 32
MTP_API_TOKEN=

MTP_HOST=node1.let-me-out.com
MTP_PORT=8443
TLS_DOMAIN=www.cloudflare.com

# слушать только localhost; бот ходит через SSH-туннель с NL-сервера
API_LISTEN=127.0.0.1
API_PORT=8081

USERS_FILE=/srv/mtproto/data/users.json
COMPOSE_DIR=/srv/mtproto

# 0 = без ограничения. 3-5 разумно: не даёт раздать купленный доступ в чат
MAX_CONNS_PER_USER=0
