[Unit]
Description=MTProto secrets management API
After=docker.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/srv/mtproto/api.env
ExecStart=/usr/bin/python3 /srv/mtproto/mtproto-api.py
Restart=always
RestartSec=5
# сервис пишет только в свой каталог
ProtectSystem=strict
ReadWritePaths=/srv/mtproto/data
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
